{
  "name": "log-data",
  "version": "1.0.0",
  "description": "An environment-aware logging library for client and server (using Pino on server and Console on client).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/**/*.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "log",
    "logging",
    "pino",
    "console"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "eslint": "^10.4.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "type": "module"
}
